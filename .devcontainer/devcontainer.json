{
  "name": "FLOWEBUY Development",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-22-bookworm",
  "postCreateCommand": "cd server && npm install --no-audit --no-fund",
  "postStartCommand": "cd server && npm start",
  "forwardPorts": [
    3000
  ],
  "portsAttributes": {
    "3000": {
      "label": "FLOWEBUY — aplicação e API",
      "onAutoForward": "openBrowser"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode"
      ]
    }
  }
}
